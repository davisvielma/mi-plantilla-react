{
	"name": "mi-plantilla-react",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"lint": "biome lint ./src",
		"format": "biome format --write ./src",
		"check": "biome check --write ."
