	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-query-devtools": "^5.102.8",
		"axios": "^1.20.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.3.0",
		"lucide-react": "^1.45.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.87.0",
		"react-router": "^8.3.1",
		"shadcn": "^4.21.0",
		"sonner": "^2.0.8",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.2",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/node": "^22.20.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"typescript": "~6.0.2",
		"vite": "^8.2.2"
	},
	"lint-staged": {
		"*.{ts,tsx,json,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
